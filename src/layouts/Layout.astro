---
type Props = {
	title?: string;
	description?: string;
};

const {
	title = 'Cavalier Robotics | Team 619',
	description = 'Cavalier Robotics Team 619 in Charlottesville, Virginia.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=Saira+Semi+Condensed:wght@500;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--team-orange: #e57200;
		--team-orange-soft: #ffb15a;
		--team-blue: #232d4b;
		--team-blue-bright: #2f5eaf;
		--team-deep: #1c2333;
		--team-dark: #121827;
		--team-slate: #3d4b65;
		--team-cream: #f3f8ff;
		--team-white: #ffffff;
		--border: #cfd9ea;
		--shadow: 0 16px 36px rgba(18, 24, 39, 0.12);
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
		color: var(--team-deep);
		background:
			linear-gradient(rgba(47, 94, 175, 0.06) 1px, transparent 1px),
			linear-gradient(90deg, rgba(47, 94, 175, 0.06) 1px, transparent 1px),
			radial-gradient(circle at 12% 8%, rgba(229, 114, 0, 0.16), transparent 38%),
			radial-gradient(circle at 86% 10%, rgba(47, 94, 175, 0.16), transparent 40%),
			linear-gradient(180deg, #f8fbff 0%, #edf3fb 100%);
		background-size: 24px 24px, 24px 24px, auto, auto, auto;
		font-family: 'Manrope', sans-serif;
		line-height: 1.5;
	}

	h1,
	h2,
	h3 {
		margin: 0;
		line-height: 1.1;
		font-family: 'Saira Semi Condensed', sans-serif;
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}

	p {
		margin: 0;
	}

	a {
		color: inherit;
	}

	.page-wrap {
		width: min(1150px, 92vw);
		margin: 0 auto;
		padding: 1rem 0 4rem;
	}

	.glass-card {
		border: 1px solid var(--border);
		background: rgba(255, 255, 255, 0.92);
		box-shadow: var(--shadow);
		border-radius: 0.65rem;
	}

	.section {
		margin-top: 2.8rem;
	}

	.section-heading {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		margin-bottom: 1.1rem;
		font-size: clamp(1.5rem, 1.1rem + 2vw, 2.2rem);
		color: var(--team-blue);
	}

	.section-heading::before {
		content: '';
		width: 1.6rem;
		height: 0.35rem;
		border-radius: 999px;
		background: var(--team-orange);
	}

	.chip {
		display: inline-flex;
		align-items: center;
		padding: 0.28rem 0.75rem;
		border-radius: 0.4rem;
		border: 1px solid rgba(35, 45, 75, 0.25);
		background: rgba(35, 45, 75, 0.08);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		font-weight: 700;
		color: var(--team-blue);
	}

	.btn-row {
		display: flex;
		gap: 0.7rem;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 0.45rem;
		padding: 0.7rem 1.2rem;
		text-decoration: none;
		font-weight: 700;
		transition: transform 220ms ease, box-shadow 220ms ease, background-color 220ms ease, border-color 220ms ease;
	}

	.btn:hover {
		transform: translateY(-2px);
	}

	.btn-primary {
		background: var(--team-orange);
		color: #1a1a1a;
		border: 1px solid #c66100;
		box-shadow: 0 10px 22px rgba(229, 114, 0, 0.28);
	}

	.btn-secondary {
		border: 1px solid rgba(35, 45, 75, 0.3);
		color: var(--team-blue);
		background: rgba(255, 255, 255, 0.95);
	}

	.top-nav {
		position: sticky;
		top: 0.5rem;
		z-index: 10;
		margin-top: 0.5rem;
		padding: 0.75rem 0.85rem;
		display: flex;
		justify-content: space-between;
		gap: 0.8rem;
		align-items: center;
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(8px);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-weight: 800;
		text-decoration: none;
	}

	.brand-logo {
		height: clamp(2.2rem, 2rem + 0.8vw, 3rem);
		width: auto;
		display: block;
		object-fit: contain;
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1;
		text-transform: uppercase;
	}

	.brand-text strong {
		font-size: 1.1rem;
		letter-spacing: 0.08em;
		font-family: 'Saira Semi Condensed', sans-serif;
		color: var(--team-blue);
	}

	.brand-text span {
		font-size: 0.68rem;
		letter-spacing: 0.06em;
		color: #4f5f79;
		margin-top: 0.15rem;
	}

	.nav-links {
		display: flex;
		gap: 0.8rem;
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	.nav-links a {
		text-decoration: none;
		font-weight: 700;
		color: #2e3f59;
		font-size: 0.9rem;
		padding: 0.32rem 0.52rem;
		border-radius: 0.3rem;
		transition: color 180ms ease, background-color 180ms ease;
	}

	.nav-links a:hover {
		color: var(--team-blue);
		background: rgba(229, 114, 0, 0.14);
	}

	@media (max-width: 760px) {
		.top-nav {
			align-items: flex-start;
			flex-direction: column;
			padding: 0.85rem;
		}

		.nav-links {
			justify-content: flex-start;
			gap: 0.7rem 0.95rem;
		}

		.page-wrap {
			width: min(1150px, 94vw);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.reveal {
			animation: rise 620ms ease both;
		}

		.reveal-delay {
			animation: rise 720ms ease both;
		}

		@keyframes rise {
			from {
				opacity: 0;
				transform: translateY(14px);
			}

			to {
				opacity: 1;
				transform: translateY(0);
			}
		}
	}
</style>
