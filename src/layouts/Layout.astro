---
import ClientRouter from 'astro/components/ClientRouter.astro';
type Props = {
	title?: string;
	description?: string;
	image?: string;
};

const {
	title = 'Cavalier Robotics | Team 619',
	description = 'Cavalier Robotics Team 619 in Charlottesville, Virginia.',
	image = '/branding/full-colored-on-transparent.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<title>{title}</title>
		<ClientRouter />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=Saira+Semi+Condensed:wght@500;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* ── Design tokens ───────────────────────────────────────────────────── */
	:root {
		--orange:      #e57200;
		--orange-dark: #b85a00;
		--blue:        #232d4b;
		--blue-mid:    #2f5eaf;
		--ink:         #1c2333;
		--ink-muted:   #4a5b74;
		--ink-faint:   #697586;
		--bg:          #eef2f7;
		--surface:     #ffffff;
		--border:      #dae0ea;
		--shadow:      0 1px 3px rgba(18, 24, 39, 0.08), 0 4px 14px rgba(18, 24, 39, 0.05);
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
		color: var(--ink);
		/* Dot-grid background — cool blueprint feel, zero warm tones */
		background-color: var(--bg);
		background-image: radial-gradient(circle, rgba(35, 45, 75, 0.13) 1px, transparent 1px);
		background-size: 22px 22px;
		font-family: 'Manrope', sans-serif;
		line-height: 1.6;
	}

	h1,
	h2,
	h3 {
		margin: 0;
		line-height: 1.05;
		font-family: 'Saira Semi Condensed', sans-serif;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	p {
		margin: 0;
	}

	a {
		color: inherit;
	}

	/* ── Layout ──────────────────────────────────────────────────────────── */
	.page-wrap {
		width: min(1140px, 92vw);
		margin: 0 auto;
		padding: 0 0 5rem;
	}

	/* Flat white card — replaces glass morphism */
	.glass-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 0.4rem;
		box-shadow: var(--shadow);
	}

	.section {
		margin-top: 3.5rem;
	}

	/* ── Section heading with vertical orange accent bar ─────────────────── */
	.section-heading {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin-bottom: 1.4rem;
		font-size: clamp(1.3rem, 1rem + 1.5vw, 1.9rem);
		color: var(--blue);
	}

	.section-heading::before {
		content: '';
		display: block;
		width: 4px;
		height: 1.1em;
		border-radius: 2px;
		background: var(--orange);
		flex-shrink: 0;
	}

	/* ── Chip / badge ────────────────────────────────────────────────────── */
	.chip {
		display: inline-flex;
		align-items: center;
		padding: 0.22rem 0.65rem;
		border-radius: 0.2rem;
		background: rgba(35, 45, 75, 0.07);
		border: 1px solid rgba(35, 45, 75, 0.16);
		color: var(--blue-mid);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		font-weight: 800;
	}

	/* ── Buttons ─────────────────────────────────────────────────────────── */
	.btn-row {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 0.3rem;
		padding: 0.65rem 1.4rem;
		text-decoration: none;
		font-weight: 700;
		font-size: 0.875rem;
		letter-spacing: 0.03em;
		transition: background-color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
	}

	.btn:hover {
		transform: translateY(-1px);
	}

	.btn-primary {
		background: var(--orange);
		color: #fff;
		border: 1px solid var(--orange-dark);
		box-shadow: 0 4px 14px rgba(229, 114, 0, 0.3);
	}

	.btn-primary:hover {
		background: var(--orange-dark);
	}

	.btn-secondary {
		background: var(--surface);
		border: 1.5px solid var(--blue);
		color: var(--blue);
	}

	.btn-secondary:hover {
		background: rgba(35, 45, 75, 0.05);
	}

	/* ── Card hover lift ─────────────────────────────────────────────────── */
	.benefit-card,
	.skill-card,
	.first-stat,
	.update-card,
	.tier-card,
	.perk-card {
		transition: transform 220ms ease, box-shadow 220ms ease;
	}

	.benefit-card:hover,
	.skill-card:hover,
	.first-stat:hover,
	.update-card:hover,
	.tier-card:hover,
	.perk-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 28px rgba(18, 24, 39, 0.13);
	}

	/* ── Navigation ──────────────────────────────────────────────────────── */
	.top-nav {
		position: sticky;
		top: 0.75rem;
		z-index: 10;
		margin-top: 0.75rem;
		padding: 0.75rem 1rem;
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: center;
		/* Orange left rail = the industrial brand accent */
		border-left: 3px solid var(--orange);
		transition: background-color 250ms ease, backdrop-filter 250ms ease, box-shadow 250ms ease;
	}

	.top-nav.scrolled {
		background: rgba(238, 242, 247, 0.42);
		backdrop-filter: blur(16px) saturate(1.4);
		-webkit-backdrop-filter: blur(16px) saturate(1.4);
		box-shadow: 0 2px 20px rgba(18, 24, 39, 0.12);
		border-bottom: 1px solid rgba(35, 45, 75, 0.1);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		text-decoration: none;
	}

	.brand-logo {
		height: clamp(2rem, 1.8rem + 0.8vw, 2.9rem);
		width: auto;
		display: block;
		object-fit: contain;
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1;
		text-transform: uppercase;
	}

	.brand-text strong {
		font-size: 1rem;
		letter-spacing: 0.1em;
		font-family: 'Saira Semi Condensed', sans-serif;
		color: var(--blue);
	}

	.brand-text span {
		font-size: 0.65rem;
		letter-spacing: 0.08em;
		color: var(--ink-faint);
		margin-top: 0.2rem;
	}

	.nav-links {
		display: flex;
		gap: 0.1rem;
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	.nav-links a {
		text-decoration: none;
		font-weight: 700;
		color: var(--ink-muted);
		font-size: 0.78rem;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		padding: 0.38rem 0.6rem;
		border-radius: 0.25rem;
		transition: color 150ms ease, background-color 150ms ease;
	}

	.nav-links a:hover {
		color: var(--blue);
		background: rgba(35, 45, 75, 0.07);
	}

	.nav-links a.nav-donate {
		color: var(--surface);
		background: var(--orange);
		border-radius: 0.25rem;
		padding: 0.38rem 0.75rem;
	}

	.nav-links a.nav-donate:hover {
		background: var(--orange-dark);
		color: var(--surface);
	}

	.nav-links a[aria-current="page"] {
		color: var(--blue);
		background: rgba(35, 45, 75, 0.09);
	}

	/* Desktop: nav-bar is just the brand row; button stays hidden */
	.nav-bar {
		display: flex;
		align-items: center;
	}

	.menu-toggle {
		display: none;
	}

	.bar {
		display: block;
		width: 22px;
		height: 2px;
		background: var(--blue);
		border-radius: 2px;
		transition: transform 220ms ease, opacity 180ms ease;
	}

	@media (max-width: 920px) {
		.top-nav {
			padding: 0.75rem 1rem;
			gap: 0;
			display: flex;
			flex-direction: column;
		}

		.nav-bar {
			width: 100%;
			justify-content: space-between;
		}

		/* Hamburger button */
		.menu-toggle {
			display: flex;
			flex-direction: column;
			justify-content: center;
			gap: 5px;
			background: none;
			border: none;
			cursor: pointer;
			padding: 0.35rem;
			border-radius: 0.25rem;
			transition: background 150ms ease;
		}

		.menu-toggle:hover {
			background: rgba(35, 45, 75, 0.07);
		}

		/* Animate bars → X when open */
		.top-nav.nav-open .bar:nth-child(1) {
			transform: translateY(7px) rotate(45deg);
		}

		.top-nav.nav-open .bar:nth-child(2) {
			opacity: 0;
			transform: scaleX(0);
		}

		.top-nav.nav-open .bar:nth-child(3) {
			transform: translateY(-7px) rotate(-45deg);
		}

		/* Collapsed nav links */
		.nav-links {
			flex-direction: column;
			width: 100%;
			max-height: 0;
			overflow: hidden;
			opacity: 0;
			transition: max-height 280ms ease, opacity 220ms ease, padding 280ms ease;
			padding-top: 0;
			gap: 0.15rem;
		}

		/* Open state */
		.top-nav.nav-open .nav-links {
			max-height: 28rem;
			opacity: 1;
			padding-top: 0.6rem;
		}

		.nav-links a {
			padding: 0.6rem 0.5rem;
			font-size: 0.82rem;
		}

		.nav-links a.nav-donate {
			margin-top: 0.25rem;
			text-align: center;
			padding: 0.6rem 0.75rem;
		}

		.page-wrap {
			width: min(1140px, 94vw);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.reveal {
			animation: rise 480ms ease both;
		}

		.reveal-delay {
			animation: rise 600ms ease both;
		}

		@keyframes rise {
			from {
				opacity: 0;
				transform: translateY(10px);
			}

			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		/* ── Scroll-reveal ───────────────────────────────────────────────── */
		.scroll-reveal {
			opacity: 0;
			transform: translateY(22px);
			transition: opacity 0.55s ease, transform 0.55s ease;
		}

		.scroll-reveal.in-view {
			opacity: 1;
			transform: none;
		}
	}
</style>

<script>
	// Re-run setup after every View Transition navigation
	document.addEventListener('astro:page-load', () => {
		// ── Nav scroll glass effect ──────────────────────────────────────
		const nav = document.querySelector('.top-nav');
		if (nav) {
			const onScroll = () => {
				nav.classList.toggle('scrolled', window.scrollY > 40);
			};
			window.addEventListener('scroll', onScroll, { passive: true });
			onScroll();
		}

		// ── Scroll-triggered reveal ──────────────────────────────────────
		if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			const targets = document.querySelectorAll(
				'.section:not(.reveal):not(.reveal-delay)'
			);

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('in-view');
							observer.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
			);

			targets.forEach((el) => {
				el.classList.add('scroll-reveal');
				observer.observe(el);
			});
		}
	});
</script>
