---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<aside class="open-house-banner glass-card">
  <div class="banner-copy">
    <span class="chip">Now Recruiting</span>
    <h2>Fall Training Has Started &mdash; Join Us!</h2>
    <p class="banner-lead">
      FRC 101 is underway &mdash; open to all team members, prospective members, and anyone interested in mentoring.
    </p>
    <p class="banner-meta">Wednesdays 6:30&ndash;9 PM &bull; Saturdays 1&ndash;5 PM &bull; <a href="/calendar">Full calendar &rarr;</a></p>
  </div>
  <img
    class="banner-img"
    src={`${base}/uploads/prototype-small.jpg`}
    alt="Cavalier Robotics robot prototype"
    loading="eager"
  />
</aside>

<style>
  .open-house-banner {
    margin-top: 1.2rem;
    padding: clamp(1.5rem, 1rem + 2.5vw, 2.2rem);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: stretch;
    overflow: hidden;
    border-top: 4px solid var(--orange);
    position: relative;
  }

  .banner-copy {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .open-house-banner h2 {
    font-size: clamp(1.5rem, 1.1rem + 2vw, 2.2rem);
    color: var(--blue);
    line-height: 1.1;
  }

  .banner-lead {
    color: var(--ink-muted);
    font-size: clamp(0.9rem, 0.82rem + 0.4vw, 1.05rem);
    max-width: 68ch;
  }

  .banner-meta {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--orange-dark);
  }

  .banner-meta a {
    color: inherit;
  }

  .banner-img {
    height: 100%;
    width: clamp(9rem, 7rem + 6vw, 15rem);
    object-fit: cover;
    object-position: center;
    border-radius: 0.25rem;
    display: block;
  }

  @media (max-width: 600px) {
    .open-house-banner {
      grid-template-columns: 1fr;
    }

    .banner-img {
      display: none;
    }
  }
</style>
