---
import { Image } from 'astro:assets';
import brandLogo from '../assets/branding/full-colored-on-transparent.png';
// No props — all nav links are site-wide constants
const { pathname } = Astro.url;
const is = (href: string) =>
	href === '/'
		? pathname === '/'
		: pathname === href || pathname.startsWith(href + '/');
---

<header class="top-nav glass-card reveal" transition:persist>
	<div class="nav-bar">
		<a href="/" class="brand" aria-label="Cavalier Robotics Home">
			<Image
				class="brand-logo"
				src={brandLogo}
				alt="Cavalier Robotics logo"
				loading="eager"
			/>
			<span class="brand-text">
				<strong>Cavalier Robotics</strong>
				<span>Team 619</span>
			</span>
		</a>
		<button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-nav">
			<span class="bar"></span>
			<span class="bar"></span>
			<span class="bar"></span>
		</button>
	</div>

	<nav class="nav-links" id="primary-nav" aria-label="Primary navigation">
		<a href="/about" aria-current={is('/about') ? 'page' : undefined}>About</a>
		<a href="/gallery" aria-current={is('/gallery') ? 'page' : undefined}>Gallery</a>
		<a href="/sponsorships" aria-current={is('/sponsorships') ? 'page' : undefined}>Sponsorships</a>
		<a href="/calendar" aria-current={is('/calendar') ? 'page' : undefined}>Calendar</a>
		<a href="/contact" aria-current={is('/contact') ? 'page' : undefined}>Contact</a>
		<a href="/donations" class="nav-donate" aria-current={is('/donations') ? 'page' : undefined}>Donate</a>
	</nav>
</header>

<script>
	const toggle = document.querySelector('.menu-toggle') as HTMLButtonElement | null;
	const header = document.querySelector('.top-nav');

	toggle?.addEventListener('click', () => {
		const open = header?.classList.toggle('nav-open');
		toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
		toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
	});

	// Close menu when a nav link is clicked
	document.querySelectorAll('.nav-links a').forEach((link) => {
		link.addEventListener('click', () => {
			header?.classList.remove('nav-open');
			toggle?.setAttribute('aria-expanded', 'false');
			toggle?.setAttribute('aria-label', 'Open navigation');
		});
	});
</script>
