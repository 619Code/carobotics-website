---
import Layout from '../layouts/Layout.astro';
import TopNav from '../components/TopNav.astro';
import PageHero from '../components/PageHero.astro';
import { getEntry } from 'astro:content';

const calEntry = await getEntry('calendarPage', 'calendar');
if (!calEntry) throw new Error('Missing calendar page content in src/content/pages/calendar.md');
const cal = calEntry.data;
---

<Layout
	title="Calendar | Cavalier Robotics Team 619"
	description="View upcoming meetings, competition dates, and team events for Cavalier Robotics FRC Team 619."
>
	<div class="page-wrap">
		<TopNav />

		<main>
			<!-- ── Hero ──────────────────────────────────────────────────────── -->
			<PageHero
				chip={cal.heroChip}
				title={cal.heroTitle}
				lead={cal.heroLead}
				art={cal.heroArt}
				artHeight={cal.artHeight}
			/>

			<!-- ── Calendar embed ────────────────────────────────────────────── -->
			<section class="section">
				<div class="calendar-wrap glass-card">
					<iframe
						title="Cavalier Robotics Team Calendar"
						src={cal.calendarEmbedSrc}
						loading="lazy"
						frameborder="0"
						scrolling="no"
					></iframe>
				</div>
			</section>

			<!-- ── Subscribe ─────────────────────────────────────────────────── -->
			<section class="section">
				<div class="glass-card subscribe-panel">
					<h2>Subscribe to Our Calendar</h2>
					<p>
						Add Team 619's calendar to your own app to get event reminders automatically. Works
						with Google Calendar, Apple Calendar, Outlook, and any app that supports iCal.
					</p>
					<div class="btn-row">
						<a
							class="btn btn-primary"
							href={cal.googleCalendarUrl}
							target="_blank"
							rel="noreferrer"
						>
							Add to Google Calendar
						</a>
						<a
							class="btn btn-secondary"
							href={cal.icalUrl}
						>
							Subscribe via iCal
						</a>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<p>© {new Date().getFullYear()} Cavalier Robotics FRC Team 619 · Charlottesville, VA</p>
		</footer>
	</div>
</Layout>

<style>
	/* ── Hero ──────────────────────────────────────────────────────────── */
	/* ── Calendar embed wrapper ────────────────────────────────────────── */
	.calendar-wrap {
		padding: 1.25rem;
		overflow: hidden;
	}

	.calendar-wrap iframe {
		display: block;
		width: 100%;
		min-height: 680px;
		border: none;
		border-radius: 0.25rem;
	}

	/* ── Subscribe panel ────────────────────────────────────────────────── */
	.subscribe-panel {
		padding: clamp(1.5rem, 3vw, 2.25rem);
	}

	.subscribe-panel h2 {
		font-family: 'Saira Semi Condensed', sans-serif;
		font-size: 1.4rem;
		color: var(--blue);
		margin: 0 0 0.6rem;
	}

	.subscribe-panel p {
		color: var(--ink-muted);
		margin: 0 0 1.25rem;
		max-width: 56ch;
	}

	/* ── Footer ─────────────────────────────────────────────────────────── */
	.site-footer {
		text-align: center;
		padding: 2rem 0 1.5rem;
		color: var(--ink-faint);
		font-size: 0.78rem;
	}

	/* ── Responsive ─────────────────────────────────────────────────────── */
	@media (max-width: 720px) {
		.calendar-wrap iframe {
			min-height: 480px;
		}
	}
</style>
