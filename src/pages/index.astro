---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const page = (await getCollection('pages')).find((entry) => entry.id === 'home');

if (!page) {
	throw new Error('Missing home page content in src/content/pages/home.md');
}

const news = (await getCollection('news'))
	.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
	.slice(0, 2);

const toSlug = (id: string) => id.replace(/\.(md|mdx)$/, '');

const home = page.data;
---

<Layout title={`${home.title} | ${home.teamNumber}`} description={home.mission}>
	<div class="page-wrap">
		<header class="top-nav glass-card reveal">
			<a href="#top" class="brand" aria-label="Cavalier Robotics Home">
				<img
					class="brand-logo"
					src="/branding/full-colored-on-transparent.png"
					alt="Cavalier Robotics logo"
					loading="eager"
				/>
				<span class="brand-text">
					<strong>Cavalier Robotics</strong>
					<span>{home.teamNumber}</span>
				</span>
			</a>

			<nav class="nav-links" aria-label="Primary navigation">
				<a href="#about">About</a>
				<a href="#skills">Skills</a>
				<a href="#gallery">Gallery</a>
				<a href="#sponsors">Sponsors</a>
				<a href="/news">News</a>
				<a href="#contact">Contact</a>
			</nav>
		</header>

		<main id="top">
			<section class="hero glass-card section reveal-delay" id="about">
				<div class="hero-copy">
					<span class="chip">{home.teamNumber} • {home.city}</span>
					<h1>{home.title}</h1>
					<p class="hero-tagline">{home.tagline}</p>
					<p class="hero-mission">{home.mission}</p>
					<div class="btn-row">
						<a class="btn btn-primary" href={home.ctaHref}>{home.ctaLabel}</a>
						<a class="btn btn-secondary" href={home.secondaryCtaHref}>{home.secondaryCtaLabel}</a>
					</div>
				</div>

				<div class="hero-media">
					<img src={home.heroImage} alt="Cavalier Robotics team members collaborating" loading="eager" />
				</div>
			</section>

			<section class="section" id="skills">
				<h2 class="section-heading">Through Our Team You Will Learn</h2>
				<div class="skills-grid">
					<article class="glass-card skill-card">
						<h3>Engineering and Build</h3>
						<ul>
							{home.engineeringSkills.map((skill) => <li>{skill}</li>)}
						</ul>
					</article>
					<article class="glass-card skill-card">
						<h3>Leadership and Strategy</h3>
						<ul>
							{home.leadershipSkills.map((skill) => <li>{skill}</li>)}
						</ul>
					</article>
				</div>
			</section>

			<section class="section" id="gallery">
				<h2 class="section-heading">Our Team</h2>
				<p class="section-intro">
					In the lab and at events, Team 619 combines playful energy with serious execution.
				</p>

				<div class="gallery-grid">
					{home.galleryImages.map((image) => (
						<figure class="glass-card gallery-item">
							<img src={image.src} alt={image.alt} loading="lazy" />
						</figure>
					))}
				</div>
			</section>

			<section class="section" id="sponsors">
				<h2 class="section-heading">Special Thanks to Our 2025-2026 Sponsors</h2>
				<div class="sponsors-grid glass-card">
					{home.sponsors.map((sponsor) => (
						<div class="sponsor-item">
							<img src={sponsor.src} alt={sponsor.alt} loading="lazy" />
						</div>
					))}
				</div>
			</section>

			<section class="section" id="news">
				<h2 class="section-heading">Latest Team Updates</h2>
				<div class="updates-grid">
					{news.map((entry) => (
						<article class="glass-card update-card">
							{entry.data.image && (
								<img src={entry.data.image} alt={entry.data.imageAlt ?? entry.data.title} loading="lazy" />
							)}
							<div>
								<p class="update-date">
									{entry.data.publishDate.toLocaleDateString('en-US', {
										month: 'short',
										day: 'numeric',
										year: 'numeric',
									})}
								</p>
								<h3>{entry.data.title}</h3>
								<p>{entry.data.excerpt}</p>
								<a href={`/news/${toSlug(entry.id)}/`}>Read more</a>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="section" id="contact">
				<h2 class="section-heading">Get In Touch</h2>
				<div class="contact-panel glass-card">
					<div>
						<p>
							Have questions or want to join the team? Reach out and we will connect with you.
						</p>
						<div class="btn-row">
							<a class="btn btn-primary" href={`mailto:${home.contact.email}`}>Email the Team</a>
							<a class="btn btn-secondary" href={`tel:${home.contact.phone.replace(/[^\d+]/g, '')}`}>
								Call {home.contact.phone}
							</a>
						</div>
					</div>

					<dl class="contact-list">
						<div>
							<dt>Email</dt>
							<dd><a href={`mailto:${home.contact.email}`}>{home.contact.email}</a></dd>
						</div>
						<div>
							<dt>Phone</dt>
							<dd>{home.contact.phone}</dd>
						</div>
						<div>
							<dt>Mailing</dt>
							<dd>{home.contact.mailingAddress}</dd>
						</div>
						<div>
							<dt>Workshop</dt>
							<dd>{home.contact.workshopAddress}</dd>
						</div>
					</dl>

					<div class="social-row">
						{home.social.map((item) => (
							<a href={item.href} target="_blank" rel="noreferrer">{item.label}</a>
						))}
					</div>
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
	.hero {
		margin-top: 1.1rem;
		padding: clamp(1rem, 0.7rem + 2vw, 2rem);
		display: grid;
		grid-template-columns: 1.08fr 0.92fr;
		gap: 1rem;
		overflow: hidden;
		border-top: 4px solid var(--team-blue);
	}

	.hero-copy {
		display: grid;
		gap: 0.8rem;
		align-content: start;
	}

	.hero h1 {
		font-size: clamp(2.1rem, 1.6rem + 3vw, 3.8rem);
		color: var(--team-blue);
	}

	.hero-tagline {
		font-size: clamp(1.06rem, 0.95rem + 0.5vw, 1.28rem);
		font-weight: 800;
		color: #233450;
	}

	.hero-mission {
		color: #4a5a74;
		max-width: 58ch;
	}

	.hero-media {
		border-radius: 0.55rem;
		overflow: hidden;
		min-height: 250px;
		box-shadow: var(--shadow);
		border: 1px solid var(--border);
	}

	.hero-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.skills-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.skill-card {
		padding: 1.15rem;
		border-top: 3px solid var(--team-blue-bright);
	}

	.skill-card h3 {
		margin-bottom: 0.8rem;
		font-size: 1.3rem;
		color: var(--team-blue);
	}

	.skill-card ul {
		margin: 0;
		padding-left: 1.15rem;
		display: grid;
		gap: 0.45rem;
	}

	.section-intro {
		color: #4a5b74;
		margin-bottom: 0.95rem;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.gallery-item {
		overflow: hidden;
		margin: 0;
		border: 1px solid var(--border);
		border-radius: 0.55rem;
	}

	.gallery-item:nth-child(1),
	.gallery-item:nth-child(4) {
		grid-column: span 7;
	}

	.gallery-item:nth-child(2),
	.gallery-item:nth-child(3),
	.gallery-item:nth-child(5),
	.gallery-item:nth-child(6) {
		grid-column: span 5;
	}

	.gallery-item img {
		width: 100%;
		height: 100%;
		min-height: 210px;
		object-fit: cover;
		display: block;
	}

	.sponsors-grid {
		display: grid;
		gap: 0.7rem;
		grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
		padding: 1rem;
		border-top: 4px solid var(--team-orange);
	}

	.sponsor-item {
		background: #fff;
		border: 1px solid var(--border);
		border-radius: 0.5rem;
		display: grid;
		place-items: center;
		padding: 0.55rem;
		min-height: 88px;
	}

	.sponsor-item img {
		max-width: 100%;
		max-height: 70px;
		object-fit: contain;
	}

	.updates-grid {
		display: grid;
		gap: 0.9rem;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.update-card {
		display: grid;
		grid-template-columns: 170px 1fr;
		gap: 0.8rem;
		padding: 0.8rem;
		border-left: 4px solid var(--team-orange);
	}

	.update-card img {
		width: 100%;
		height: 100%;
		min-height: 130px;
		object-fit: cover;
		border-radius: 0.45rem;
	}

	.update-date {
		font-size: 0.77rem;
		color: #60718b;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.update-card h3 {
		font-size: 1.35rem;
		margin: 0.35rem 0;
	}

	.update-card p {
		color: #4c5c77;
	}

	.update-card a {
		display: inline-block;
		margin-top: 0.7rem;
		font-weight: 800;
		color: var(--team-blue);
		text-decoration-color: var(--team-orange);
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}

	.contact-panel {
		padding: 1.15rem;
		display: grid;
		gap: 1rem;
		border-top: 4px solid var(--team-blue-bright);
	}

	.contact-list {
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 0.75rem;
	}

	.contact-list dt {
		text-transform: uppercase;
		letter-spacing: 0.09em;
		color: #60718a;
		font-size: 0.74rem;
		font-weight: 700;
	}

	.contact-list dd {
		margin: 0.35rem 0 0;
		font-weight: 600;
	}

	.social-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
	}

	.social-row a {
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 800;
		color: var(--team-blue);
		border: 1px solid var(--border);
		border-radius: 0.4rem;
		padding: 0.35rem 0.75rem;
		background: #fff;
	}

	.social-row a:hover {
		background: rgba(47, 94, 175, 0.08);
	}

	@media (max-width: 980px) {
		.hero {
			grid-template-columns: 1fr;
		}

		.gallery-item:nth-child(n) {
			grid-column: span 6;
		}

		.updates-grid,
		.skills-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 690px) {
		.gallery-grid {
			grid-template-columns: 1fr;
		}

		.gallery-item:nth-child(n) {
			grid-column: span 1;
		}

		.update-card {
			grid-template-columns: 1fr;
		}
	}
</style>
