---
import Layout from '../layouts/Layout.astro';
import TopNav from '../components/TopNav.astro';
import ContactFooter from '../components/ContactFooter.astro';
import SponsorsGrid from '../components/SponsorsGrid.astro';
import { getCollection } from 'astro:content';

const page = (await getCollection('pages')).find((entry) => entry.id === 'home');

if (!page) {
	throw new Error('Missing home page content in src/content/pages/home.md');
}

const news = (await getCollection('news'))
	.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
	.slice(0, 2);

const toSlug = (id: string) => id.replace(/\.(md|mdx)$/, '');

const home = page.data;
---

<Layout title={`${home.title} | ${home.teamNumber}`} description={home.mission}>
	<div class="page-wrap">
		<TopNav />

		<main id="top">
			<section class="hero glass-card section reveal-delay" id="about">
				<div class="hero-copy">
					<span class="chip">{home.teamNumber} • {home.city}</span>
					<h1>{home.title}</h1>
					<p class="hero-tagline">{home.tagline}</p>
					<p class="hero-mission">{home.mission}</p>
					<div class="btn-row">
						<a class="btn btn-primary" href={home.ctaHref}>{home.ctaLabel}</a>
						<a class="btn btn-secondary" href={home.secondaryCtaHref}>{home.secondaryCtaLabel}</a>
					</div>
				</div>

				<div class="hero-media">
					<img src={home.heroImage} alt="Cavalier Robotics team members collaborating" loading="eager" />
				</div>
			</section>

			<!-- Mascot floats between hero and skills, overlapping both -->
			<img
				class="mascot-float"
				src="/artwork/person-riding-619-robot.png"
				alt=""
				aria-hidden="true"
				loading="eager"
			/>

			<section class="section" id="skills">
				<h2 class="section-heading">Through Our Team You Will Learn</h2>
				<div class="skills-grid">
					<article class="glass-card skill-card">
						<img class="skill-art" src="/artwork/duck-with-wrench.png" alt="" aria-hidden="true" loading="lazy" />
						<h3>Engineering and Build</h3>
						<ul>
							{home.engineeringSkills.map((skill) => <li>{skill}</li>)}
						</ul>
					</article>
					<article class="glass-card skill-card">
						<img class="skill-art" src="/artwork/duck-with-screwdriver.png" alt="" aria-hidden="true" loading="lazy" />
						<h3>Leadership and Strategy</h3>
						<ul>
							{home.leadershipSkills.map((skill) => <li>{skill}</li>)}
						</ul>
					</article>
				</div>
			</section>

			<section class="section" id="gallery">
				<h2 class="section-heading">Our Team</h2>
				<p class="section-intro">
					In the lab and at events, Team 619 combines playful energy with serious execution.
				</p>

				<div class="gallery-grid">
					{home.galleryImages.map((image) => (
						<figure class="glass-card gallery-item">
							<img src={image.src} alt={image.alt} loading="lazy" />
						</figure>
					))}
				</div>
			</section>

			<SponsorsGrid />

			<section class="section" id="news">
				<h2 class="section-heading">Latest Team Updates</h2>
				<div class="updates-grid">
					{news.map((entry) => (
						<article class="glass-card update-card">
							{entry.data.image && (
								<img src={entry.data.image} alt={entry.data.imageAlt ?? entry.data.title} loading="lazy" />
							)}
							<div>
								<p class="update-date">
									{entry.data.publishDate.toLocaleDateString('en-US', {
										month: 'short',
										day: 'numeric',
										year: 'numeric',
									})}
								</p>
								<h3>{entry.data.title}</h3>
								<p>{entry.data.excerpt}</p>
								<a href={`/news/${toSlug(entry.id)}/`}>Read more</a>
							</div>
						</article>
					))}
				</div>
			</section>

			<ContactFooter />
		</main>
	</div>
</Layout>

<style>
	/* ── Floating section mascot ────────────────────────────────────────── */
	.mascot-float {
		display: block;
		pointer-events: none;
		position: relative;
		z-index: 2;
		height: clamp(9rem, 7rem + 5vw, 15rem);
		width: auto;
		margin-left: auto;       /* right-align within page-wrap */
		margin-top: -3.5rem;     /* overlap the hero card's bottom */
		margin-bottom: -2.5rem;  /* overlap the skills section top */
		filter: drop-shadow(0 6px 18px rgba(18, 24, 39, 0.14));
	}

	/* ── Hero ─────────────────────────────────────────────────────────────── */
	.hero {
		margin-top: 1.2rem;
		padding: clamp(1.5rem, 1rem + 2.5vw, 2.5rem);
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 2rem;
		overflow: hidden;
		border-top: 3px solid var(--orange);
	}

	.hero-copy {
		display: grid;
		gap: 1rem;
		align-content: center;
	}

	.hero h1 {
		font-size: clamp(2.4rem, 1.6rem + 4vw, 4.2rem);
		color: var(--blue);
		line-height: 1;
	}

	.hero-tagline {
		font-size: clamp(1rem, 0.9rem + 0.4vw, 1.15rem);
		font-weight: 700;
		color: var(--ink);
	}

	.hero-mission {
		color: var(--ink-muted);
		max-width: 52ch;
		line-height: 1.7;
	}

	.hero-media {
		border-radius: 0.4rem;
		overflow: hidden;
		min-height: 260px;
		border: 1px solid var(--border);
	}

	.hero-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* ── Skills ──────────────────────────────────────────────────────────── */
	.skills-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.skill-card {
		padding: 1.4rem;
		padding-right: 5.5rem;  /* room for corner art */
		border-top: 3px solid var(--blue-mid);
		position: relative;
		overflow: hidden;
	}

	.skill-art {
		position: absolute;
		right: 0.8rem;
		top: 0.5rem;
		height: 5rem;
		width: auto;
		pointer-events: none;
		opacity: 0.9;
	}

	.skill-card h3 {
		margin-bottom: 0.9rem;
		font-size: 1.2rem;
		color: var(--blue);
	}

	.skill-card ul {
		margin: 0;
		padding-left: 1.1rem;
		display: grid;
		gap: 0.4rem;
		color: var(--ink-muted);
		font-size: 0.9rem;
	}

	/* ── Gallery ─────────────────────────────────────────────────────────── */
	.section-intro {
		color: var(--ink-muted);
		margin-bottom: 1rem;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 0.5rem;
	}

	.gallery-item {
		overflow: hidden;
		margin: 0;
		border-radius: 0.35rem;
		border: 1px solid var(--border);
	}

	.gallery-item:nth-child(1),
	.gallery-item:nth-child(4) {
		grid-column: span 7;
	}

	.gallery-item:nth-child(2),
	.gallery-item:nth-child(3),
	.gallery-item:nth-child(5),
	.gallery-item:nth-child(6) {
		grid-column: span 5;
	}

	.gallery-item img {
		width: 100%;
		height: 100%;
		min-height: 200px;
		object-fit: cover;
		display: block;
	}

	/* ── Updates ─────────────────────────────────────────────────────────── */
	.updates-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.update-card {
		display: grid;
		grid-template-columns: 160px 1fr;
		gap: 0.9rem;
		padding: 0.9rem;
		border-left: 3px solid var(--orange);
	}

	.update-card img {
		width: 100%;
		height: 100%;
		min-height: 120px;
		object-fit: cover;
		border-radius: 0.3rem;
		display: block;
	}

	.update-date {
		font-size: 0.7rem;
		color: var(--ink-faint);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-weight: 700;
	}

	.update-card h3 {
		font-size: 1.25rem;
		margin: 0.3rem 0;
		color: var(--blue);
	}

	.update-card p {
		color: var(--ink-muted);
		font-size: 0.9rem;
	}

	.update-card a {
		display: inline-block;
		margin-top: 0.6rem;
		font-weight: 700;
		font-size: 0.78rem;
		color: var(--orange);
		text-decoration: none;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.update-card a:hover {
		text-decoration: underline;
	}

	/* ── Responsive ──────────────────────────────────────────────────────── */
	@media (max-width: 980px) {
		.hero {
			grid-template-columns: 1fr;
		}

		.gallery-item:nth-child(n) {
			grid-column: span 6;
		}

		.updates-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 600px) {
		.skills-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 690px) {
		.gallery-grid {
			grid-template-columns: 1fr;
		}

		.gallery-item:nth-child(n) {
			grid-column: span 1;
		}

		.update-card {
			grid-template-columns: 1fr;
		}
	}
</style>
