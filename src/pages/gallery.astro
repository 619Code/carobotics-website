---
import Layout from '../layouts/Layout.astro';
import TopNav from '../components/TopNav.astro';
import ContactFooter from '../components/ContactFooter.astro';
import { getCollection } from 'astro:content';
import PageHero from '../components/PageHero.astro';

const page = (await getCollection('pages')).find((entry) => entry.id === 'home');

if (!page) {
	throw new Error('Missing home page content in src/content/pages/home.md');
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const images = page.data.galleryImages;
---

<Layout
	title="Gallery | Cavalier Robotics Team 619"
	description="Photos from Team 619's build seasons, competitions, and community events."
>
	<div class="page-wrap">
		<TopNav />

		<main>
			<!-- ── Hero ──────────────────────────────────────────────────────── -->
			<PageHero
				chip="Team Photos"
				title="Gallery"
				lead="A look inside Team 619 — from the shop floor to the competition arena."
				art="/uploads/duck-riding-robot-2026-comp-year.png"
				artHeight="clamp(7rem, 5rem + 5vw, 11rem)"
			/>

			<!-- ── Photo grid ─────────────────────────────────────────────── -->
			<section class="section">
				<div class="photo-grid">
					{images.map((image, i) => (
						<figure
							class="photo-item"
							data-index={i}
						>
							<button
								class="photo-btn"
								aria-label={`View full size: ${image.alt}`}
								data-src={base + image.src}
								data-alt={image.alt}
							>
								<img src={base + image.src} alt={image.alt} loading="lazy" />
							</button>
						</figure>
					))}
				</div>
			</section>

			<ContactFooter />
		</main>
	</div>
</Layout>

<!-- ── Lightbox ───────────────────────────────────────────────────────── -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
	<button class="lightbox-close" id="lightbox-close" aria-label="Close photo viewer">✕</button>
	<img class="lightbox-img" id="lightbox-img" src="" alt="" />
</div>

<script>
	const lightbox   = document.getElementById('lightbox') as HTMLElement;
	const lbImg      = document.getElementById('lightbox-img') as HTMLImageElement;
	const lbClose    = document.getElementById('lightbox-close') as HTMLButtonElement;
	const btns       = document.querySelectorAll<HTMLButtonElement>('.photo-btn');

	function open(src: string, alt: string) {
		lbImg.src = src;
		lbImg.alt = alt;
		lightbox.hidden = false;
		document.body.style.overflow = 'hidden';
		lbClose.focus();
	}

	function close() {
		lightbox.hidden = true;
		lbImg.src = '';
		document.body.style.overflow = '';
	}

	btns.forEach((btn) => {
		btn.addEventListener('click', () => {
			open(btn.dataset.src ?? '', btn.dataset.alt ?? '');
		});
	});

	lbClose.addEventListener('click', close);

	lightbox.addEventListener('click', (e) => {
		if (e.target === lightbox) close();
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !lightbox.hidden) close();
	});
</script>

<style>
	/* ── Photo grid ────────────────────────────────────────────────────── */
	.photo-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
	}

	.photo-item {
		margin: 0;
		overflow: hidden;
		border-radius: 0.75rem;
		border: 1px solid var(--border);
		aspect-ratio: 4 / 3;
		background: var(--surface);
	}

	/* First image: full-width panoramic banner */
	.photo-item:first-child {
		grid-column: 1 / -1;
		aspect-ratio: 3 / 1;
	}

	.photo-btn {
		display: block;
		width: 100%;
		height: 100%;
		padding: 0;
		border: none;
		background: none;
		cursor: zoom-in;
	}

	.photo-btn img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease, filter 0.3s ease;
	}

	.photo-btn:hover img,
	.photo-btn:focus-visible img {
		transform: scale(1.04);
		filter: brightness(1.08);
	}

	.photo-btn:focus-visible {
		outline: 3px solid var(--orange);
		outline-offset: 2px;
	}

	/* ── Lightbox ───────────────────────────────────────────────────────── */
	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 1000;
		background: rgba(10, 14, 26, 0.92);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1.5rem;
	}

	.lightbox[hidden] {
		display: none;
	}

	.lightbox-img {
		max-width: 100%;
		max-height: 90vh;
		border-radius: 0.5rem;
		box-shadow: 0 16px 64px rgba(0, 0, 0, 0.6);
		object-fit: contain;
	}

	.lightbox-close {
		position: absolute;
		top: 1.2rem;
		right: 1.4rem;
		background: none;
		border: none;
		color: #fff;
		font-size: 1.5rem;
		line-height: 1;
		cursor: pointer;
		padding: 0.4rem 0.6rem;
		border-radius: 0.3rem;
	}

	.lightbox-close:hover,
	.lightbox-close:focus-visible {
		background: rgba(255, 255, 255, 0.12);
		outline: none;
	}

	/* ── Responsive ─────────────────────────────────────────────────────── */
	@media (max-width: 720px) {
		.photo-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.photo-item:first-child {
			aspect-ratio: 16 / 9;
		}
	}

	@media (max-width: 480px) {
		.photo-grid {
			grid-template-columns: 1fr;
		}

		.photo-item,
		.photo-item:first-child {
			aspect-ratio: 16 / 9;
		}
	}
</style>
