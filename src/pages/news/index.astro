---
import Layout from '../../layouts/Layout.astro';
import TopNav from '../../components/TopNav.astro';
import ContactFooter from '../../components/ContactFooter.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('news')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const toSlug = (id: string) => id.replace(/\.(md|mdx)$/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Team 619 News | Cavalier Robotics" description="Latest updates from Team 619.">
  <div class="page-wrap">
    <TopNav />

    <main class="section reveal-delay">
      <h1 class="section-heading">Team Updates</h1>
      <p class="intro">Build season notes, competition recaps, and team highlights.</p>

      <div class="news-list">
        {entries.map((entry) => (
          <article class="glass-card news-card">
            {entry.data.image && <img src={entry.data.image} alt={entry.data.imageAlt ?? entry.data.title} loading="lazy" />}
            <div>
              <p class="date">
                {entry.data.publishDate.toLocaleDateString('en-US', {
                  month: 'long',
                  day: 'numeric',
                  year: 'numeric',
                })}
              </p>
              <h2>{entry.data.title}</h2>
              <p>{entry.data.excerpt}</p>
              <a href={`${base}/news/${toSlug(entry.id)}/`}>Read article</a>
            </div>
          </article>
        ))}
      </div>
    </main>
    <ContactFooter />
  </div>
</Layout>

<style>
  .intro {
    color: var(--ink-muted);
    margin-top: 0.4rem;
  }

  .news-list {
    margin-top: 1.2rem;
    display: grid;
    gap: 1rem;
  }

  .news-card {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 1rem;
    padding: 1rem;
    border-left: 3px solid var(--blue-mid);
  }

  .news-card img {
    width: 100%;
    height: 100%;
    min-height: 160px;
    object-fit: cover;
    border-radius: 0.3rem;
    display: block;
    border: 1px solid var(--border);
  }

  .news-card h2 {
    margin: 0.3rem 0;
    font-size: 1.65rem;
    color: var(--blue);
  }

  .news-card p {
    margin-bottom: 0.45rem;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }

  .news-card .date {
    color: var(--ink-faint);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
  }

  .news-card a {
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--orange);
    text-decoration: none;
  }

  .news-card a:hover {
    text-decoration: underline;
  }

  @media (max-width: 780px) {
    .news-card {
      grid-template-columns: 1fr;
    }
  }
</style>
