---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('news')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const toSlug = (id: string) => id.replace(/\.(md|mdx)$/, '');
---

<Layout title="Team 619 News | Cavalier Robotics" description="Latest updates from Team 619.">
  <div class="page-wrap">
    <header class="top-nav glass-card reveal">
      <a href="/" class="brand" aria-label="Back to home">
        <img
          class="brand-logo"
          src="/branding/full-colored-on-transparent.png"
          alt="Cavalier Robotics logo"
          loading="eager"
        />
        <span class="brand-text">
          <strong>Cavalier Robotics</strong>
          <span>Team 619</span>
        </span>
      </a>
      <nav class="nav-links" aria-label="News navigation">
        <a href="/">Home</a>
      </nav>
    </header>

    <main class="section reveal-delay">
      <h1 class="section-heading">Team Updates</h1>
      <p class="intro">Build season notes, competition recaps, and team highlights.</p>

      <div class="news-list">
        {entries.map((entry) => (
          <article class="glass-card news-card">
            {entry.data.image && <img src={entry.data.image} alt={entry.data.imageAlt ?? entry.data.title} loading="lazy" />}
            <div>
              <p class="date">
                {entry.data.publishDate.toLocaleDateString('en-US', {
                  month: 'long',
                  day: 'numeric',
                  year: 'numeric',
                })}
              </p>
              <h2>{entry.data.title}</h2>
              <p>{entry.data.excerpt}</p>
              <a href={`/news/${toSlug(entry.id)}/`}>Read article</a>
            </div>
          </article>
        ))}
      </div>
    </main>
  </div>
</Layout>

<style>
  .intro {
    color: #4a5b74;
    margin-top: 0.3rem;
  }

  .news-list {
    margin-top: 1.1rem;
    display: grid;
    gap: 1rem;
  }

  .news-card {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 0.95rem;
    padding: 0.95rem;
    border-left: 4px solid var(--team-blue-bright);
  }

  .news-card img {
    width: 100%;
    height: 100%;
    min-height: 160px;
    object-fit: cover;
    border-radius: 0.45rem;
    border: 1px solid var(--border);
  }

  .news-card h2 {
    margin: 0.3rem 0;
    font-size: 1.7rem;
    color: var(--team-blue);
  }

  .news-card p {
    margin-bottom: 0.45rem;
    color: #4b5b75;
  }

  .news-card .date {
    color: #60718b;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
  }

  .news-card a {
    font-weight: 800;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    text-decoration-color: var(--team-orange);
  }

  @media (max-width: 780px) {
    .news-card {
      grid-template-columns: 1fr;
      color: var(--team-blue);
    }
  }
</style>
