---
import Layout from '../../layouts/Layout.astro';
import TopNav from '../../components/TopNav.astro';
import ContactFooter from '../../components/ContactFooter.astro';
import { getCollection, render } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export async function getStaticPaths() {
  const entries = await getCollection('news');
  const toSlug = (id: string) => id.replace(/\.(md|mdx)$/, '');

  return entries.map((entry) => ({
    params: { slug: toSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | Team 619`} description={entry.data.excerpt}>
  <div class="page-wrap">
    <TopNav />

    <article class="article glass-card section reveal-delay">
      <p class="article-date">
        {entry.data.publishDate.toLocaleDateString('en-US', {
          month: 'long',
          day: 'numeric',
          year: 'numeric',
        })}
      </p>
      <h1>{entry.data.title}</h1>
      {entry.data.image && <img src={base + entry.data.image} alt={entry.data.imageAlt ?? entry.data.title} loading="eager" />}
      <p class="excerpt">{entry.data.excerpt}</p>
      <div class="content">
        <Content />
      </div>
      <a class="back-link" href={base + "/news"}>Back to all updates</a>
    </article>
    <ContactFooter />
  </div>
</Layout>

<style>
  .article {
    padding: clamp(1.2rem, 0.9rem + 1.5vw, 2rem);
    display: grid;
    gap: 1rem;
    border-top: 3px solid var(--orange);
  }

  .article-date {
    color: var(--ink-faint);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
  }

  .article h1 {
    font-size: clamp(1.9rem, 1.3rem + 2vw, 3rem);
    color: var(--blue);
  }

  .article > img {
    width: 100%;
    max-height: 460px;
    object-fit: cover;
    border-radius: 0.4rem;
    border: 1px solid var(--border);
    display: block;
  }

  .excerpt {
    color: var(--ink-muted);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .content {
    color: var(--ink);
    display: grid;
    gap: 0.9rem;
    line-height: 1.75;
  }

  .back-link {
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--orange);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }
</style>
