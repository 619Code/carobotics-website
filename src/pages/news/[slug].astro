---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('news');
  const toSlug = (id: string) => id.replace(/\.(md|mdx)$/, '');

  return entries.map((entry) => ({
    params: { slug: toSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | Team 619`} description={entry.data.excerpt}>
  <div class="page-wrap">
    <header class="top-nav glass-card reveal">
      <a href="/" class="brand" aria-label="Back to home">
        <img
          class="brand-logo"
          src="/branding/full-colored-on-transparent.png"
          alt="Cavalier Robotics logo"
          loading="eager"
        />
        <span class="brand-text">
          <strong>Cavalier Robotics</strong>
          <span>Team 619</span>
        </span>
      </a>
      <nav class="nav-links" aria-label="Article navigation">
        <a href="/news">All updates</a>
      </nav>
    </header>

    <article class="article glass-card section reveal-delay">
      <p class="article-date">
        {entry.data.publishDate.toLocaleDateString('en-US', {
          month: 'long',
          day: 'numeric',
          year: 'numeric',
        })}
      </p>
      <h1>{entry.data.title}</h1>
      {entry.data.image && <img src={entry.data.image} alt={entry.data.imageAlt ?? entry.data.title} loading="eager" />}
      <p class="excerpt">{entry.data.excerpt}</p>
      <div class="content">
        <Content />
      </div>
      <a class="back-link" href="/news">Back to all updates</a>
    </article>
  </div>
</Layout>

<style>
  .article {
    padding: clamp(1rem, 0.8rem + 1.2vw, 1.8rem);
    display: grid;
    gap: 0.9rem;
    border-top: 4px solid var(--team-orange);
  }

  .article-date {
    color: #60718b;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
  }

  .article h1 {
    font-size: clamp(1.9rem, 1.3rem + 2vw, 3rem);
    color: var(--team-blue);
  }

  .article > img {
    width: 100%;
    max-height: 460px;
    object-fit: cover;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
  }

  .excerpt {
    color: #4a5b74;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .content {
    color: #34425a;
    display: grid;
    gap: 0.8rem;
  }

  .back-link {
    font-weight: 800;
    color: var(--team-blue);
    text-decoration-thickness: 2px;
    text-decoration-color: var(--team-orange);
    text-underline-offset: 3px;
  }
</style>
